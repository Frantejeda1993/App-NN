# Desarrollo local contra los emuladores de Firebase (`npm run dev:emulators`).
# Proyecto "demo-": los emuladores no permiten tocar servicios reales.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-app-nn.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-app-nn
VITE_FIREBASE_APP_ID=demo-app-id
