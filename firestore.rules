rules_version = '2';

// Única barrera de seguridad real (plan Spark, sin backend): la app valida con
// zod, pero estas reglas deciden qué se puede leer y escribir.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identidad --------------------------------------------------------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Id del documento en members/: email en minúsculas.
    function emailKey() {
      return request.auth.token.email.lower();
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(emailKey());
    }

    // Socio = documento members/{email} existente con active == true.
    function isMember() {
      return signedIn()
        && exists(memberPath())
        && get(memberPath()).data.active == true;
    }

    // ---- Auditoría: quién y cuándo los pone el servidor, no el cliente ------
    function auditCreateOk() {
      let d = request.resource.data;
      return d.createdBy == emailKey() && d.updatedBy == emailKey()
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    function auditUpdateOk() {
      let d = request.resource.data;
      return d.updatedBy == emailKey() && d.updatedAt == request.time
        && d.createdBy == resource.data.createdBy
        && d.createdAt == resource.data.createdAt;
    }

    function canCreate() { return isMember() && auditCreateOk() && sizeOk(); }
    function canUpdate() { return isMember() && auditUpdateOk() && sizeOk(); }

    // ---- Validaciones básicas ----------------------------------------------
    function nonEmptyString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function isCents(v) { return v is int; }
    function isPositiveCents(v) { return v is int && v > 0; }

    // Reparto: hasta 20 participantes. Que sume 100 % lo valida la app (las
    // reglas no pueden sumar los valores de un mapa dinámico).
    function validShares(s) { return s is map && s.size() > 0 && s.size() <= 20; }

    // Tope de campos por documento (evita inflar documentos con basura).
    function sizeOk() { return request.resource.data.size() <= 40; }

    // Fecha de negocio "AAAA-MM-DD".
    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // Concurrencia optimista: cada escritura sube `rev` en 1. Si otro socio guardó
    // antes, el `rev` que manda este cliente ya no es el siguiente y se rechaza.
    function revCreateOk() { return request.resource.data.get('rev', 0) == 0; }
    function revUpdateOk() {
      return request.resource.data.get('rev', 0) == resource.data.get('rev', 0) + 1;
    }

    // ---- Lista blanca -------------------------------------------------------
    // Los socios se dan de alta desde la consola de Firebase (nunca desde la app).
    match /members/{email} {
      // Cada usuario puede consultar su propio documento (para saber si tiene acceso).
      allow get: if signedIn() && email == emailKey();
      // Los socios activos ven la lista (participaciones, "quién pagó").
      allow list: if isMember();
      allow write: if false;
    }

    // ---- Configuración ------------------------------------------------------
    // Reparto por defecto opcional: si está, como cualquier reparto (≤ 20 entradas).
    function validSettings() {
      let d = request.resource.data;
      return !('defaultShares' in d) || d.defaultShares == null || validShares(d.defaultShares);
    }

    // Configuración inicial de la billetera: mapas acotados (los importes los valida la app).
    function validOpening(docId) {
      let d = request.resource.data;
      return docId != 'opening' || (
        d.boxes is map && d.boxes.size() <= 50
        && d.people is map && d.people.size() <= 21
        && (d.date == null || isIsoDate(d.date))
      );
    }

    match /settings/{docId} {
      allow read: if isMember();
      allow create: if canCreate() && docId in ['workshop', 'services', 'opening'] && validSettings() && validOpening(docId);
      allow update: if canUpdate() && validSettings() && validOpening(docId);
      allow delete: if false;
    }

    // ---- Clientes -----------------------------------------------------------
    function validClient() {
      return nonEmptyString(request.resource.data.name, 200);
    }

    match /clients/{clientId} {
      allow read: if isMember();
      allow create: if canCreate() && validClient();
      allow update: if canUpdate() && validClient();
      allow delete: if false; // se conservan por historial

      match /contacts/{contactId} {
        allow read: if isMember();
        allow create: if canCreate() && isIsoDate(request.resource.data.date);
        allow update: if canUpdate() && isIsoDate(request.resource.data.date);
        // El historial de contactos se conserva (como los clientes).
        allow delete: if false;
      }
    }

    // ---- Proyectos ----------------------------------------------------------
    function validProject() {
      let d = request.resource.data;
      return nonEmptyString(d.title, 200)
        && nonEmptyString(d.clientId, 128)
        && d.status in ['pendiente', 'en_proceso', 'entregado', 'finalizado', 'cobrado', 'cancelado', 'archivado']
        && validShares(d.shares);
    }

    match /projects/{projectId} {
      allow read: if isMember();
      allow create: if canCreate() && validProject() && revCreateOk();
      allow update: if canUpdate() && validProject() && revUpdateOk();
      allow delete: if false; // se archivan
    }

    // ---- Cajas y gastos generales ---------------------------------------------
    match /boxes/{boxId} {
      allow read: if isMember();
      allow create: if canCreate() && nonEmptyString(request.resource.data.name, 200);
      allow update: if canUpdate() && nonEmptyString(request.resource.data.name, 200);
      allow delete: if false; // se desactivan
    }

    function validGeneralExpense() {
      let d = request.resource.data;
      return nonEmptyString(d.name, 200)
        && d.kind in ['fijo', 'esporadico']
        && isPositiveCents(d.amountCents)
        && validShares(d.shares);
    }

    match /generalExpenses/{expenseId} {
      allow read: if isMember();
      allow create: if canCreate() && validGeneralExpense();
      allow update: if canUpdate() && validGeneralExpense();
      allow delete: if false;
    }

    // ---- Movimientos de dinero: versionados, auditados, sin borrado físico ---
    function optId(v) { return v == null || (v is string && v.size() > 0 && v.size() <= 128); }
    function isId(v) { return v is string && v.size() > 0 && v.size() <= 128; }
    // Socio referenciado (quién pagó / retiro…) debe existir en members.
    function optMember(v) {
      return v == null || (v is string && exists(/databases/$(database)/documents/members/$(v)));
    }
    // …y estar activo al asignarlo (un movimiento viejo de un ex socio se puede seguir corrigiendo).
    function optActiveMember(v) {
      return v == null || (v is string && get(/databases/$(database)/documents/members/$(v)).data.active == true);
    }
    function memberFieldOk(field) {
      return (resource != null && request.resource.data[field] == resource.data[field])
        || optActiveMember(request.resource.data[field]);
    }

    // Reparto entre proyectos: hasta 10 partes (las reglas no tienen bucles, se
    // revisa cada posición). Cada parte: importe entero > 0 (una parte negativa
    // permitiría inflar otro proyecto); la suma = total. Que cada parte tenga un
    // proyecto válido lo controla la app: revisarlo acá supera el tope de 1000
    // expresiones que evalúan las reglas por escritura.
    function splitAt(l, i) { return l.size() > i ? l[i].amountCents : 0; }
    function splitOk(l, i) { return l.size() <= i || isPositiveCents(l[i].amountCents); }
    function splitsValid(l) {
      return splitOk(l, 0) && splitOk(l, 1) && splitOk(l, 2) && splitOk(l, 3) && splitOk(l, 4)
        && splitOk(l, 5) && splitOk(l, 6) && splitOk(l, 7) && splitOk(l, 8) && splitOk(l, 9);
    }
    function splitsSum(l) {
      return splitAt(l, 0) + splitAt(l, 1) + splitAt(l, 2) + splitAt(l, 3) + splitAt(l, 4)
        + splitAt(l, 5) + splitAt(l, 6) + splitAt(l, 7) + splitAt(l, 8) + splitAt(l, 9);
    }

    function validMovement() {
      let d = request.resource.data;
      let fields = ['type', 'status', 'amountCents', 'date', 'boxId', 'toBoxId', 'paidBy', 'memberEmail',
        'projectId', 'projectSplits', 'generalExpenseId', 'category', 'description',
        'version', 'deleted', 'deletedReason', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
      let isExpense = d.type in ['gasto_proyecto', 'gasto_general'];
      let usesMember = d.type in ['retiro', 'aporte', 'reintegro', 'reparto'];
      let usesMemberBox = d.type in ['retiro', 'aporte', 'reintegro'];
      let hasSplits = d.projectSplits is list && d.projectSplits.size() > 0;
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.type in ['cobro', 'gasto_proyecto', 'gasto_general', 'retiro', 'aporte', 'transferencia', 'reintegro', 'reparto']
        && d.status in ['pagado', 'pendiente_pago']
        && isPositiveCents(d.amountCents)
        && isIsoDate(d.date)
        && d.version is int
        && d.deleted is bool
        && d.deletedReason is string && d.deletedReason.size() <= 500
        // Una baja lógica siempre lleva motivo.
        && (d.deleted == false || d.deletedReason.size() > 0)
        && d.description is string && d.description.size() <= 5000
        && d.category is string && d.category.size() <= 100
        && optId(d.boxId) && optId(d.toBoxId) && optId(d.projectId) && optId(d.generalExpenseId)
        && d.projectSplits is list && d.projectSplits.size() <= 10
        && optMember(d.paidBy) && optMember(d.memberEmail)
        // Reglas por tipo (espejo de MovementDataSchema): un dato suelto que no
        // corresponde al tipo no puede sumar en otro lado (p. ej. reparto en un cobro).
        && (d.status == 'pagado' || isExpense)
        && (d.type == 'transferencia' || d.toBoxId == null)
        && (isExpense || d.paidBy == null)
        && (usesMember || d.memberEmail == null)
        && (d.type in ['cobro', 'gasto_proyecto'] || d.projectId == null)
        && (d.type == 'gasto_general' || d.generalExpenseId == null)
        && (d.type == 'gasto_proyecto' || !hasSplits)
        && !(d.projectId != null && hasSplits)
        && (!hasSplits || (splitsValid(d.projectSplits) && splitsSum(d.projectSplits) == d.amountCents))
        && (d.status == 'pagado' || (d.boxId == null && d.paidBy == null))
        && (d.type != 'cobro' || (isId(d.projectId) && isId(d.boxId)))
        && (!usesMemberBox || (d.memberEmail != null && isId(d.boxId)))
        // El reparto del fondo del taller no mueve dinero de las cajas.
        && (d.type != 'reparto' || (d.memberEmail != null && d.boxId == null))
        && (d.type != 'transferencia' || (isId(d.boxId) && isId(d.toBoxId) && d.boxId != d.toBoxId))
        && (d.type != 'gasto_general' || isId(d.generalExpenseId))
        && (d.type != 'gasto_proyecto' || isId(d.projectId) || hasSplits)
        && (!isExpense || d.status != 'pagado' || ((d.boxId == null) != (d.paidBy == null)));
    }

    // La entrada auditLog/{id}_v{version} debe escribirse en el mismo batch.
    function hasAuditLog(movementId, version) {
      return existsAfter(/databases/$(database)/documents/auditLog/$(movementId + '_v' + string(version)));
    }

    match /movements/{movementId} {
      allow read: if isMember();
      allow create: if canCreate() && validMovement()
        && memberFieldOk('paidBy') && memberFieldOk('memberEmail')
        && request.resource.data.version == 1
        && request.resource.data.deleted == false
        && hasAuditLog(movementId, 1);
      allow update: if canUpdate() && validMovement()
        && memberFieldOk('paidBy') && memberFieldOk('memberEmail')
        && resource.data.deleted == false
        && request.resource.data.version == resource.data.version + 1
        && hasAuditLog(movementId, request.resource.data.version);
      allow delete: if false;
    }

    // El registro debe reflejar EXACTAMENTE el movimiento: `after` = estado nuevo y
    // `before` = estado anterior (ambos sin los campos de auditoría).
    function logMatchesMovement(log) {
      let path = /databases/$(database)/documents/movements/$(log.entityId);
      let auditKeys = ['createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
      let afterDoc = getAfter(path).data;
      return log.after is map
        && afterDoc.diff(log.after).affectedKeys().hasOnly(auditKeys)
        && (log.version == 1
          ? (log.action == 'create' && log.before == null)
          : (log.action in ['update', 'delete'] && log.before is map
            && get(path).data.diff(log.before).affectedKeys().hasOnly(auditKeys)))
        && (log.action != 'delete' || afterDoc.deleted == true)
        && (log.action != 'update' || afterDoc.deleted == false);
    }

    match /auditLog/{logId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['entity', 'entityId', 'version', 'action', 'before', 'after', 'by', 'at'])
        && request.resource.data.by == emailKey()
        && request.resource.data.at == request.time
        && request.resource.data.entity == 'movements'
        && request.resource.data.version is int
        && logId == request.resource.data.entityId + '_v' + string(request.resource.data.version)
        && getAfter(/databases/$(database)/documents/movements/$(request.resource.data.entityId)).data.version
          == request.resource.data.version
        && logMatchesMovement(request.resource.data);
      allow update, delete: if false;
    }

    // ---- Catálogos y plantillas -------------------------------------------------
    match /catalogMaterials/{itemId} {
      allow read: if isMember();
      allow create: if canCreate() && nonEmptyString(request.resource.data.name, 200)
        && isCents(request.resource.data.sheetPriceCents);
      allow update: if canUpdate() && nonEmptyString(request.resource.data.name, 200)
        && isCents(request.resource.data.sheetPriceCents);
      allow delete: if false; // se desactivan (los presupuestos los referencian)
    }

    match /catalogEdgeBanding/{itemId} {
      allow read: if isMember();
      allow create: if canCreate() && nonEmptyString(request.resource.data.name, 200)
        && isCents(request.resource.data.pricePerMeterCents);
      allow update: if canUpdate() && nonEmptyString(request.resource.data.name, 200)
        && isCents(request.resource.data.pricePerMeterCents);
      allow delete: if false;
    }

    match /catalogHardware/{itemId} {
      allow read: if isMember();
      allow create: if canCreate() && nonEmptyString(request.resource.data.name, 200)
        && isCents(request.resource.data.priceCents);
      allow update: if canUpdate() && nonEmptyString(request.resource.data.name, 200)
        && isCents(request.resource.data.priceCents);
      allow delete: if false;
    }

    match /templates/{templateId} {
      allow read: if isMember();
      allow create: if canCreate() && nonEmptyString(request.resource.data.name, 200);
      allow update: if canUpdate() && nonEmptyString(request.resource.data.name, 200);
      allow delete: if isMember();
    }

    // ---- Presupuestos ---------------------------------------------------------
    function validQuote() {
      let d = request.resource.data;
      return nonEmptyString(d.title, 200)
        && d.status in ['borrador', 'enviado', 'aceptado', 'aceptado_parcial', 'rechazado', 'vencido', 'finalizado', 'archivado']
        && d.version is int && d.version >= 1
        && d.items is list && d.items.size() <= 200
        && d.freeLines is list && d.freeLines.size() <= 100
        && d.adjustments is list && d.adjustments.size() <= 50
        && (!('purchased' in d) || (d.purchased is list && d.purchased.size() <= 500));
    }

    match /quotes/{quoteId} {
      allow read: if isMember();
      allow create: if canCreate() && validQuote() && revCreateOk();
      // Un presupuesto ya enviado no puede volver a borrador (se podría borrar)
      // ni cambiar de número de versión; `rev` evita pisar el guardado de otro socio.
      allow update: if canUpdate() && validQuote() && revUpdateOk()
        && (request.resource.data.status != 'borrador' || resource.data.status == 'borrador')
        && request.resource.data.version == resource.data.version;
      // Solo se borran borradores; el resto se archiva.
      allow delete: if isMember() && resource.data.status == 'borrador';
    }

    // ---- Preferencias de cada usuario (p. ej. si ya vio el tour) ------------
    // Solo las propias: nadie lee ni cambia las de otro socio.
    match /userPrefs/{email} {
      allow read: if isMember() && email == emailKey();
      allow create, update: if isMember() && email == emailKey()
        && request.resource.data.keys().hasOnly(['tourSeenVersion', 'updatedAt'])
        && request.resource.data.tourSeenVersion is int
        && request.resource.data.tourSeenVersion >= 0 && request.resource.data.tourSeenVersion <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Cualquier otra ruta queda cerrada.
  }
}
